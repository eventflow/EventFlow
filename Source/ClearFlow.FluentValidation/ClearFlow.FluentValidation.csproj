<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PackageId>ClearFlow.FluentValidation</PackageId>
    <Title>ClearFlow.FluentValidation</Title>
    <Authors>Kyle Bradley</Authors>
    <Company>Kyle Bradley</Company>
	<Copyright>Copyright (c) Kyle Bradley 2015 - 2024</Copyright>
    <Description>FluentValidation support for commands</Description>
    <PackageTags>CQRS ES event sourcing EventStore FluentValidation</PackageTags>
    <IsPackable>true</IsPackable>
    <Version>0.2.4</Version>
	<Product>ClearFlow.FluentValidation</Product>
	<RepositoryUrl>https://github.com/kyle-bradley/EventFlow</RepositoryUrl>
	<WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventFlow\EventFlow.csproj" />
  </ItemGroup>

</Project>
